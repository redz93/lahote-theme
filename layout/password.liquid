<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }}</title>
  <style>:root{--cream:{{ settings.color_cream }};--beige:{{ settings.color_beige }};--brown:{{ settings.color_brown }};--ink:{{ settings.color_ink }};--white:{{ settings.color_white }};--berry:{{ settings.color_berry }}}</style>
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body>
  <main id="main">{{ content_for_layout }}</main>
</body>
</html>
