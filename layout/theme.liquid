<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_brown }}">
  <link rel="canonical" href="{{ canonical_url }}">
  <title>{{ page_title }}{% unless page_title contains shop.name %} – {{ shop.name }}{% endunless %}</title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  {% render 'meta-tags' %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600&family=Playfair+Display:ital,wght@0,500;0,600;1,500&display=swap" rel="stylesheet">
  <style>
    :root{--cream:{{ settings.color_cream }};--beige:{{ settings.color_beige }};--brown:{{ settings.color_brown }};--ink:{{ settings.color_ink }};--white:{{ settings.color_white }};--berry:{{ settings.color_berry }}}
  </style>
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body class="template-{{ template.name | handle }}">
  <a class="skip" href="#main">{{ 'general.skip' | t }}</a>
  {% sections 'header-group' %}
  <main id="main">{{ content_for_layout }}</main>
  {% sections 'footer-group' %}
  {% if settings.enable_snow %}<canvas id="snow" class="snow" aria-hidden="true" data-count="{{ settings.snow_count }}"></canvas>{% endif %}
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>
