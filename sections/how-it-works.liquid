<section class="section alt-band">
  <div class="wrap">
    <h2>{{ section.settings.heading }}</h2>
    <ol class="steps">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}><strong>{{ block.settings.title }}</strong><span>{{ block.settings.text }}</span></li>
      {%- endfor -%}
    </ol>
  </div>
</section>
{% schema %}
{
  "name": "Comment ça marche",
  "max_blocks": 6,
  "settings": [{ "type": "text", "id": "heading", "label": "Titre", "default": "Comment ça marche" }],
  "blocks": [{
    "type": "step", "name": "Étape",
    "settings": [
      { "type": "text", "id": "title", "label": "Titre", "default": "Étape" },
      { "type": "textarea", "id": "text", "label": "Texte" }
    ]
  }],
  "presets": [{ "name": "Comment ça marche" }]
}
{% endschema %}
