<section class="section narrow center">
  <h1>{{ shop.name }}</h1>
  {%- if shop.password_message != blank -%}<div class="desc">{{ shop.password_message }}</div>{%- endif -%}
  {%- form 'storefront_password' -%}
    {{ form.errors | default_errors }}
    <label>{{ 'password.label' | t }}<input type="password" name="password" required></label>
    <button class="btn" type="submit">{{ 'password.enter' | t }}</button>
  {%- endform -%}
</section>
{% schema %}
{ "name": "Page mot de passe" }
{% endschema %}
