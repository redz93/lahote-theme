<section class="section">
  <h1>{{ 'general.collections' | t }}</h1>
  <div class="grid">
    {%- for c in collections -%}
      <a class="card" href="{{ c.url }}">
        <div class="ph">{%- if c.image -%}{{ c.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: c.title }}{%- else -%}{{ 'collection-1' | placeholder_svg_tag }}{%- endif -%}</div>
        <h3>{{ c.title }}</h3>
      </a>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{ "name": "Liste des collections" }
{% endschema %}
