<section class="section">
  <h2>{{ section.settings.heading }}</h2>
  <ul class="perks">
    {%- for block in section.blocks -%}
      <li {{ block.shopify_attributes }}><strong>{{ block.settings.title }}</strong><span>{{ block.settings.text }}</span></li>
    {%- endfor -%}
  </ul>
</section>
{% schema %}
{
  "name": "Avantages",
  "max_blocks": 6,
  "settings": [{ "type": "text", "id": "heading", "label": "Titre", "default": "Pourquoi LAHOTE" }],
  "blocks": [{
    "type": "benefit", "name": "Avantage",
    "settings": [
      { "type": "text", "id": "title", "label": "Titre", "default": "Avantage" },
      { "type": "textarea", "id": "text", "label": "Texte" }
    ]
  }],
  "presets": [{ "name": "Avantages" }]
}
{% endschema %}
